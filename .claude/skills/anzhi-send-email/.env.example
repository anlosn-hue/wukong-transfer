# 邮件发送凭据配置模板
# 使用方法：将本文件复制为同目录下的 .env，再填写下方四项。
# .env 已被 .gitignore 排除，不会被提交或纳入版本控制。

# 发件邮箱地址
MAIL_ACCOUNT=你的邮箱@example.com

# 邮箱授权码 —— 注意：不是登录密码！
# QQ邮箱/企业邮箱均需在「邮箱设置 - 账户 - 开启SMTP服务」处生成专用授权码，
# 生成后填在这里，登录密码本身无法用于 SMTP 发信。
MAIL_AUTH_CODE=你的邮箱授权码

# SMTP 服务器地址，默认 QQ 邮箱；企业邮箱按实际情况修改
MAIL_SMTP_SERVER=smtp.qq.com

# SMTP 端口，465 为 SSL 端口（本工具固定走 SSL，不支持 STARTTLS 的 587）
MAIL_SMTP_PORT=465
